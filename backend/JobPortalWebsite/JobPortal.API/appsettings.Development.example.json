{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<neon-host>;Database=jobportal;Username=<db-user>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_LONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "JobPortalAPI",
    "Audience": "JobPortalClient",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Llm": {
    "Provider": "Gemini",
    "ApiKey": "",
    "Model": "gemini-2.0-flash"
  },
  "FileStorage": {
    "PublicBaseUrl": "https://localhost:7011"
  }
}