{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=JobPortalDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_LONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "JobPortalAPI",
    "Audience": "JobPortalClient",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "MaxImageBytes": 2097152,
    "AllowedImageExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ],
    "MaxResumeBytes": 5242880,
    "AllowedResumeExtensions": [
      ".pdf"
    ],
    "PublicBaseUrl": "https://localhost:7011"
  }
}